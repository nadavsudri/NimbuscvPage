# LemonSqueezy
LEMONSQUEEZY_API_KEY=eyJ...
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_VARIANT_ID=67890
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Public anon key — safe to expose to the browser; served to the client via
# /api/public-config for Supabase Auth (login/signup). Settings → API → anon public.
SUPABASE_ANON_KEY=eyJ...

# Site
SITE_URL=https://your-domain.vercel.app

# Product file path inside Supabase Storage "releases" bucket
PRODUCT_FILE_PATH=nimbus/Nimbus-1.0.0.zip
